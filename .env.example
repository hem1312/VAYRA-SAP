# VAYRA environment configuration (example — placeholders only, no real secrets).
# Copy to backend/.env (gitignored) and fill in real values locally.

# --- LLM provider (backend/.env or process env) ---
# Provider: demo | openai | anthropic | deepseek | kimi | ollama
LLM_PROVIDER=demo
OPENAI_API_KEY=API_KEY_PLACEHOLDER
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_TIMEOUT_SECONDS=120
ANTHROPIC_API_KEY=API_KEY_PLACEHOLDER
ANTHROPIC_MODEL=claude-sonnet-4-5
DEEPSEEK_API_KEY=API_KEY_PLACEHOLDER
KIMI_API_KEY=API_KEY_PLACEHOLDER
OLLAMA_MODEL=qwen3:14b
OLLAMA_BASE_URL=http://localhost:11434/v1

# --- Phase 3: read-only SAP integration (all optional; empty = DISCONNECTED) ---
# SAP_BASE_URL      e.g. https://sandbox.example.sap:44300  (approved non-production only)
# SAP_SYSTEM_ID     e.g. S4Q
# SAP_CLIENT        e.g. 100
# SAP_USERNAME / SAP_PASSWORD  or SAP_API_TOKEN
SAP_BASE_URL=
SAP_SYSTEM_ID=
SAP_CLIENT=
SAP_USERNAME=
SAP_PASSWORD=
SAP_API_TOKEN=
SAP_AUDIT_LOG=

# --- Phase 4: controlled execution (fail-closed defaults) ---
# READ_ONLY | DRY_RUN (default) | APPROVED_NON_PRODUCTION | CONTROLLED_PRODUCTION
# (AUTONOMOUS is refused by policy — §21)
EXECUTION_LEVEL=DRY_RUN
EXECUTION_EMERGENCY_STOP=
EXECUTION_PRODUCTION_SYSTEMS=
EXECUTION_AUDIT_LOG=
EXECUTION_AUDIT_DIR=

# --- Server ---
APP_ENV=development
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# --- Phase 6B: API security (fail-closed outside development) ----------------
# See backend/.env.example for the full explanation of these variables.
VAYRA_API_TOKEN=
VAYRA_API_TOKENS=
